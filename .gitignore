# =========================
# Backend FastAPI / Python

# Pychamp
/.idea/*
/backend-isp/.idea/*

# Variables de entorno
backend-isp/.env
backend-isp/.env.*
!backend-isp/.env.example

# Entornos virtuales
backend-isp/venv/
backend-isp/.venv/
backend-isp/env/

# Python cache / compilados
backend-isp/__pycache__/
backend-isp/**/*.py[cod]
backend-isp/*$py.class
backend-isp/.Python

# Build / distribución
backend-isp/build/
backend-isp/dist/
backend-isp/*.egg-info/

# Logs
backend-isp/*.log
backend-isp/logs/

# Test / coverage
backend-isp/.pytest_cache/
backend-isp/.coverage
backend-isp/htmlcov/
backend-isp/.mypy_cache/

# FastAPI / Uvicorn
backend-isp/.uvicorn/

# Base de datos local (si usás SQLite)
backend-isp/*.db
backend-isp/*.sqlite3

# Archivos subidos / media (si guardás uploads locales)
backend-isp/uploads/
backend-isp/media/

# IDEs
backend-isp/.vscode/
backend-isp/.idea/

# Sistema operativo
backend-isp/.DS_Store
backend-isp/Thumbs.db

# Backend FastAPI / Python
